POSTGRES_DB=flow_monitor
POSTGRES_USER=flow_user
POSTGRES_PASSWORD=change-this-postgres-password

EMQX_DASHBOARD_USER=admin
EMQX_DASHBOARD_PASSWORD=change-this-dashboard-password

MQTT_HOST=emqx
MQTT_PORT=1883
MQTT_TOPIC=meters/+/reading
MQTT_USERNAME=flow_backend
MQTT_PASSWORD=change-this-backend-mqtt-password

# Use this username/password on the field gateway.
MQTT_GATEWAY_USERNAME=gateway
MQTT_GATEWAY_PASSWORD=change-this-gateway-mqtt-password

CLOCK_SKEW_SECONDS=120
OFFLINE_AFTER_SECONDS=180

# Optional alert webhook. ALERT_WEBHOOK_TYPE supports: wechat, dingtalk.
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TYPE=wechat

# Comma-separated list, for example: http://your-server-ip
CORS_ORIGINS=*
